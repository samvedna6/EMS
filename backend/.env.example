# TaskFlow EMS Backend Environment Configuration
# Copy this file to .env for backend configuration

PORT=5000
NODE_ENV=development

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
# Leave empty ONLY for local development (uses persistent embedded engine at backend/.data/db)
MONGO_URI=

# JWT Authentication
# In production, use a strong 256-bit or 512-bit random secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# Allowed Frontend Origins for CORS (comma-separated or single URL)
FRONTEND_URL=http://localhost:9002
CLIENT_URL=http://localhost:9002
